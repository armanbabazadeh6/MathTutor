# MathTutor environment — placeholders only. Never commit real keys.
# Copy to .env.local and fill in. Local-first play needs NONE of these.

# --- Supabase (optional cloud sync; not wired to the app yet) --------------
# Public project URL (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public anon key (safe for the browser; RLS still applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Server-side overrides (no NEXT_PUBLIC_ prefix = never bundled to the browser).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# Service-role key: bypasses RLS. Server only — never add a NEXT_PUBLIC_ prefix,
# never commit the real value, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-server-only>

# --- AI word problems (optional; server-only) ------------------------------
# Server-side only: no NEXT_PUBLIC_ prefix, read in src/lib/ai/provider.ts.
# AI_PROVIDER unset -> deterministic mock/template wording (default; tests use this).
AI_PROVIDER=mock

# Endpoint + key for the generic HTTP adapter (AI_PROVIDER=http).
AI_ENDPOINT=https://<vendor-host>/v1/generate
AI_API_KEY=<server-only-vendor-key>

# Optional model name passed through to the vendor.
AI_MODEL=<model-name>

# --- App metadata (optional) ----------------------------------------------
# Public parent-area PIN. Speed bump only — it ships in the client bundle and
# every kid's data lives in this device's localStorage. Fallback: 2468.
NEXT_PUBLIC_ADMIN_PIN=2468

# Absolute site origin used for metadataBase/robots/sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://<your-domain>
